<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('partials/header') %>

    <h1><%= title %></h1>

    <% if (user) { %>
      <p>User: <%= user.username %></p>
      <p>Balance: $<%= user.balance %></p>

      <form action="/logout" method="POST" style="margin-top: 20px;">
        <button type="submit">Logout</button>
      </form>
    <% } else { %>
      <p>You are not logged in.</p>
    <% } %>

  </body>
</html>

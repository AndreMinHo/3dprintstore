<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('partials/header') %>

    <h1><%= title %></h1>
    <ul>
      <% products.forEach(p => { %>
        <li>
          <a href="/products/<%= p.id %>"><%= p.title %></a> - $<%= p.price %>
          <br>
          <img src="/images/<%= p.available_filaments[0].image %>" alt="<%= p.title %>" width="50">
        </li>
      <% }) %>
    </ul>
  </body>
</html>

<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('partials/header') %>

    <h1><%= title %></h1>

    <div style="display: flex; flex-wrap: wrap; gap: 20px;">
      <% products.forEach(p => { 
          const firstFilament = p.available_filaments?.[0];
          const firstImage = firstFilament?.images?.[0];
      %>
        <div style="border: 1px solid #ccc; padding: 10px; width: 200px;">
          <a href="/products/<%= p.id %>">
            <% if (firstImage) { %>
              <img src="/images/<%= firstImage %>" alt="<%= p.title %>" style="width: 100%; height: auto;">
            <% } else { %>
              <div style="width: 100%; height: 150px; background: #eee; display: flex; align-items: center; justify-content: center;">
                No image
              </div>
            <% } %>
          </a>
          <h3><a href="/products/<%= p.id %>"><%= p.title %></a></h3>
          <p>$<%= p.price %></p>
        </div>
      <% }) %>
    </div>
  </body>
</html>

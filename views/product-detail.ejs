<!DOCTYPE html>
<html>
  <%- include('partials/head') %>
    

  <!-- This code was partially generated by AI tools: -->
  <body>
    <%- include('partials/header') %>
    <div class="container m-1">
      <div class="row g-4">
        <!--  preview images -->
        <div class="col-md-6" id="previewColumn">
          <div class="card p-3 shadow-sm">

            <div id="imagePreview" class="d-flex gap-1 flex-wrap">
              <% if (product.available_filaments && product.available_filaments.length > 0) { %>
                <% product.available_filaments[0].images.forEach(img => { %>
                  <img
                    src="/images/<%= img %>"
                    alt="<%= product.available_filaments[0].filament %>"
                    style="width: 100%; max-width: 300px; height: auto; border: 1px solid #ccc; padding: 5px; border-radius: 6px;"
                  >
                <% }) %>
              <% } else { %>
                <div class="text-muted">No preview images</div>
              <% } %>
            </div>
          </div>
        </div>


        <div class="col-12 col-md-6" id="infoColumn">
          <h1 class="h3"><%= product.title %></h1>

          <p class="text-muted"><%= product.description %></p>

          <p class="fs-4"><strong>Price:</strong> $<%= product.price %></p>

          <div class="my-4">
            <label for="filamentSelect" class="form-label fw-semibold">Select Filament Type</label>
            <select id="filamentSelect" class="form-select w-auto">
              <% product.available_filaments.forEach((filament, index) => { %>
                <option value="<%= index %>"><%= filament.filament %></option>
              <% }) %>
            </select>
          </div>
          <% if (user) { %>
            <button class="btn btn-primary w-100 mb-3">Purchase</button>
          <% } else { %>
            <a href="/login" class="btn btn-secondary w-100 mb-3">
              Login to Purchase
            </a>
          <% } %>
          <a href="/products" class="btn btn-outline-secondary mt-3">← Back to Products</a>
        </div>
      </div>
    </div>    
  </body>

  <script>

    const filaments = <%- JSON.stringify(product.available_filaments || []) %>;
    const select = document.getElementById("filamentSelect");
    const imagePreview = document.getElementById("imagePreview");

    function renderFilamentImages(index) {
      imagePreview.innerHTML = "";
      const chosen = filaments[index];

      if (!chosen || !chosen.images || chosen.images.length === 0) {
        imagePreview.innerHTML = '<div class="text-muted">No preview images available</div>';
        return;
      }

      chosen.images.forEach(img => {
        const el = document.createElement("img");
        el.src = "/images/" + img;
        el.alt = chosen.filament;

        el.className = "img-fluid border rounded shadow-sm";
        el.style.maxWidth = "520px";
        el.style.width = "100%"
        el.style.marginBottom = "0.75rem";

        imagePreview.appendChild(el);
      });
    }

    if (filaments.length > 0) {
      renderFilamentImages(0);
    }
    select.addEventListener("change", () => {
      renderFilamentImages(select.value);
    });
  </script>

</html>

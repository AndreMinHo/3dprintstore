<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('partials/header') %>

    <h1><%= product.title %></h1>
    <p><%= product.description %></p>
    <p><strong>Price:</strong> $<%= product.price %></p>

    <h3>Select Filament Type</h3>
    <select id="filamentSelect">
      <% product.available_filaments.forEach((filament, index) => { %>
        <option value="<%= index %>"><%= filament.filament %></option>
      <% }) %>
    </select>

    <div id="imagePreview" style="margin-top: 20px; display: flex; gap: 10px;">
      <% if (product.available_filaments.length > 0) { %>
        <% product.available_filaments[0].images.forEach(img => { %>
          <img
            src="/images/<%= img %>"
            alt="<%= product.available_filaments[0].filament %>"
            style="width: 150px; height: auto; border: 1px solid #ccc; padding: 5px;"
          >
        <% }) %>
      <% } %>
    </div>

    <a href="/products">← Back to Products</a>

    <script>
      const filaments = <%- JSON.stringify(product.available_filaments) %>;
      const select = document.getElementById("filamentSelect");
      const imagePreview = document.getElementById("imagePreview");

      select.addEventListener("change", () => {
        const chosen = filaments[select.value];
        imagePreview.innerHTML = ""; // clear old images

        chosen.images.forEach(img => {
          const imageEl = document.createElement("img");
          imageEl.src = "/images/" + img;
          imageEl.alt = chosen.filament;
          imageEl.style.width = "150px";
          imageEl.style.height = "auto";
          imageEl.style.border = "1px solid #ccc";
          imageEl.style.padding = "5px";
          imagePreview.appendChild(imageEl);
        });
      });
    </script>
  </body>
</html>
